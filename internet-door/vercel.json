{
  "rewrites": [
    {
      "source": "/api/mcp/:sleutel",
      "destination": "/api/mcp?sleutel=:sleutel"
    },
    {
      "source": "/",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
